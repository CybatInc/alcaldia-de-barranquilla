{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alcaldia-de-barranquilla",
  "main": "src/index.js",
  "compatibility_date": "2024-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "vars": {
    "CYBAT_INGESTION_URL": "https://gcp-ingest.cybat.co",
    "CYBAT_MAX_BODY_BYTES": "65536",
    "PROJECT_ID": "alcaldia-de-barranquilla"
  },
  "observability": {
    "enabled": true
  }
}
